# Copy this file to .env and paste your keys (both are free):
#
# SeatGeek — live RESALE prices (USD) for EPL/Bundesliga/LaLiga/Ligue1.
#   1. Sign up at https://seatgeek.com
#   2. Go to https://seatgeek.com/account/develop and create an app
#   3. Copy the "Client ID" below
SEATGEEK_CLIENT_ID=

# Ticketmaster — live PRIMARY/face-value prices (GBP/EUR).
#   1. Sign up at https://developer.ticketmaster.com
#   2. Your default app's "Consumer Key" is the API key
TICKETMASTER_API_KEY=
